{
  // The same rules as _portfolio/command-log, pecks and environment. Run from the repo root:  markdownlint-cli2 "**/*.md"
  "config": {
    "default": true,
    // prose isn't hard-wrapped
    "MD013": false,
    // a heading may repeat under a different parent (one "Gotchas" per entry)
    "MD024": { "siblings_only": true },
    // a title: in front matter isn't a second heading
    "MD025": { "front_matter_title": "" },
    // a space inside a code span can be the point (the exact spacing a command prints)
    "MD038": false,
    // numbered steps may carry on after a code block between them
    "MD029": false
  },
  // skip what .gitignore skips
  "gitignore": true,
  "ignores": ["node_modules/**"]
}
